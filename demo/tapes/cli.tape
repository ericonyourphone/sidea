Output demo/recordings/cli.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 14
Set Width 1200
Set Height 620
Set TypingSpeed 60ms
Set Theme "Ayu Mirage"

Hide
Type "alias sidea='./sidea-demo demo'; clear"
Enter
Show

Type "sidea status"
Enter
Sleep 1.2s
Type "sidea status --json"
Enter
Sleep 1.5s
Type "sidea status --format '{icon} {title} [{position}/{duration}] vol {volume}% on {device}'"
Enter
Sleep 1.5s
Type "sidea devices"
Enter
Sleep 1.2s
Type "sidea search daft punk"
Enter
Sleep 1.5s
Type "sidea play get lucky"
Enter
Sleep 1.2s
Type "sidea vol +5"
Enter
Sleep 1s
Type "sidea like"
Enter
Sleep 2.5s
